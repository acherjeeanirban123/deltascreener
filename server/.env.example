# DeltaScreener API — environment
# Copy to .env on the server and fill in real values. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env

# ── Database ────────────────────────────────────────────────────────────────
# Password was set by the VPS bootstrap script (see SECRETS.md).
DATABASE_URL=postgres://deltascreener:CHANGE_ME@127.0.0.1:5432/deltascreener_db
# Optional: only if you later split the blog onto its own database.
# BLOG_DATABASE_URL=

# ── Cache (replaces Cloudflare KV) ──────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
NODE_ENV=production

# ── Scheduled refresh (replaces wrangler.toml [triggers] crons) ─────────────
# Do NOT go below ~5 min. At 1-minute intervals this job will saturate a small
# VPS — the same job on Cloudflare produced a $154 D1 bill at that frequency.
CRON_SCHEDULE=*/15 * * * *
CRON_RUN_ON_BOOT=false

# ── Data providers ──────────────────────────────────────────────────────────
FMP_KEY=
FMP_API_KEY=
FMP_PLAN=starter
FMP_TIER=
FMP_SUBSCRIPTION=
POLYGON_KEY=
POLYGON_API_KEY=
POLYGON_KEY_ID=
FINNHUB_KEY=
AV_KEY=

# ── Auth / admin ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
ADMIN_SECRET=
SP_ADMIN_SECRET=
BLOG_API_SECRET=

# ── Email (price alerts) ────────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@deltascreener.com

# ── Origins / CORS ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://deltascreener.com
PUBLIC_APP_URL=https://deltascreener.com
ALLOWED_ORIGINS=https://deltascreener.com,https://www.deltascreener.com,https://deltascreener.pages.dev
CORS_ORIGINS=https://deltascreener.com,https://www.deltascreener.com,https://deltascreener.pages.dev
